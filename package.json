{
  "name": "3dena-next",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @3dena/web",
    "build": "npm run build --workspace @3dena/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:golden": "npm run test --workspace @3dena/parity-contracts",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test --project=a11y",
    "test:runtime-boundary:unit": "node --test scripts/verify-production-boundary.test.mjs",
    "test:runtime-boundary": "node scripts/verify-production-boundary.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:golden && npm run build && npm run test:runtime-boundary:unit && npm run test:runtime-boundary"
  },
  "dependencies": {
    "plotly.js": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
